# Copier ce fichier en .env puis remplacer les valeurs. Ne jamais publier le fichier .env.

# Airflow
AIRFLOW_UID=50000
FERNET_KEY=a_generer
AIRFLOW__API_AUTH__JWT_SECRET=a_generer
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=choisir_un_mot_de_passe

# AWS : accès au bucket S3 (utilisateur IAM limité à ce bucket)
AWS_ACCESS_KEY_ID=a_renseigner
AWS_SECRET_ACCESS_KEY=a_renseigner
AWS_DEFAULT_REGION=eu-west-3
BUCKET_NAME=nom_du_bucket_s3

# Base NeonDB (fraud_db), au format postgresql://utilisateur:mot_de_passe@hote/fraud_db?sslmode=require
FRAUD_DB_URI=a_renseigner

# Webhook du salon Discord
DISCORD_WEBHOOK_URL=a_renseigner

# Serveur MLflow (Space Hugging Face) et son jeton d'accès
MLFLOW_TRACKING_URI=https://adresse_du_serveur_mlflow
MLFLOW_TRACKING_TOKEN=a_renseigner
